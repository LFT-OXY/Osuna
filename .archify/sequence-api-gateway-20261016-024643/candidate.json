  "cards": [
    {
      "dot": "rose",
      "title": "官方订阅什么时候能用",
      "items": [
        "开关开着：CLI 只认中转站地址，官方服务一次都不会被请求",
        "开关关掉后：CLI 配置还原，下一次请求直接走官方订阅"
      ]
    },
    {
      "dot": "emerald",
      "title": "自动切换的边界",
      "items": [
        "只在上游开始回复之前换家，且只换到选了同名模型的接口",
        "整个过程不提示，只有 daemon 日志记录"
      ]
    },
    {
      "dot": "amber",
      "title": "全部失败时",
      "items": [
        "错误写成「接口名: 上游原文」，按 CLI 自己的错误格式返回",
        "429 没带 Retry-After 时，中转站补上冷却结束的时间"
      ]
    }
  ]
