# Developer identity (local only)
.developer

# Current task pointer (each dev works on different task)
.current-task

# Session/window scoped runtime state
.runtime/

# Ralph Loop state file
.ralph-state.json

# Agent runtime files
.agents/
.agent-log
.session-id

# Task directory runtime files
.plan-log

# Atomic update temp files
*.tmp

# Update backup directories
.backup-*

# Conflict resolution temp files
*.new

# Verify skill evidence (each app's evidence/ under verify/)
verify/*/evidence/

# Verify skill evidence saved in task folders (including archived tasks)
tasks/*/verify-evidence/
tasks/archive/*/*/verify-evidence/

# Python cache
**/__pycache__/
**/*.pyc
